# Google sign-in: OAuth "Web application" client ID from Google Cloud Console
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Long random string used to sign login cookies (e.g. run: openssl rand -hex 32)
SESSION_SECRET=change-me
# Where the SQLite database lives (put it on a persistent disk in production)
DB_PATH=./data/dream-team.db
PORT=8787
# Local testing only: lets you sign in as a test player without Google (ignored in production)
DEV_LOGIN=1
